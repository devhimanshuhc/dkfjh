{
	"name": "server",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 3001",
		"start": "uv run gunicorn -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:3001",
		"test": "uv run --extra dev pytest",
		"typecheck": "uv run --extra dev mypy app config.py",
		"lint": "uv run --extra dev ruff check ."
	}
}
